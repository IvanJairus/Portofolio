          "p": "deploy.sh::gate_refused",
          "when": "refused"
        }
      ],
      "promote-uat": [
        {
          "l": "cmd",
          "m": "$ bash ci-library/scripts/deploy.sh promote --from sit --to uat",
          "p": "backend.yml::deploy.sh promote --from sit --to uat"
        },
        {
          "l": "log",
          "m": "rules checked promotion=sit->uat allowed=true",
          "p": "deploy.sh::rules checked promotion="
        },
        {
          "l": "log",
          "m": "promote from=sit to=uat",
          "p": "deploy.sh::promote from="
        },
        {
          "l": "log",
          "m": "preflight kubectl=/usr/local/bin/kubectl context=ci-runner namespace=ci-uat-ledger-service",
          "p": "deploy.sh::preflight kubectl="
        },
        {
          "l": "out",
          "m": "  when: manual and allow_failure: false, so the run waits and cannot be waved through",
          "p": "backend.yml::allow_failure: false"
        },
        {
          "l": "out",
          "m": "  ReleaseRules.validatePromotion owns the ladder: sit->uat is a step, uat->sit is not",
          "p": "ReleaseRules.groovy::validatePromotion"
        },
        {
          "l": "out",
          "m": "  ENV_TARGET_BRANCH is the map that says which branch each hop merges into",
          "p": "ReleaseRules.groovy::ENV_TARGET_BRANCH"
        }
      ],
      "promote-prod": [
        {
          "l": "cmd",
          "m": "$ bash ci-library/scripts/deploy.sh promote --from uat --to prod --wave-plan",
          "p": "backend.yml::deploy.sh promote --from uat --to prod"
        },
        {
          "l": "log",
          "m": "window env=prod day=2 hour=10 enforced=1",
          "p": "deploy.sh::window env=prod"
        },
        {
          "l": "log",
          "m": "rules checked promotion=uat->prod allowed=true",
          "p": "deploy.sh::rules checked promotion="
        },
        {
          "l": "out",
          "m": "  Mon-Thu 09:00-17:00: the hours when someone who can reverse the decision is at a desk",
          "p": "deploy.sh::change_window"
        },
        {
          "l": "out",
          "m": "  resource_group: prod, so two promotions cannot be in flight at once",
          "p": "backend.yml::resource_group: prod"
        },
        {
          "l": "out",
          "m": "  the approval chain is checked by the same class the board calls before it lets a merge through",
          "p": "ReleaseRules.groovy::approvalChainProblems"
        },
        {
          "l": "out",
          "m": "  the mobile bundle has no prod button at all: its last step is an internal track",
          "p": "mobile.yml::distribute --track internal"
        }
      ],
      "observability": [
        {
          "l": "cmd",
          "m": "$ bash ci-library/scripts/observability-push.sh pipeline",
          "p": "backend.yml::observability-push.sh pipeline"
        },
        {
          "l": "log",
          "m": "metric name=gateway_release_passed labels=project=\"core-api\",version=\"R1.4.3\" value=1",
          "p": "observability-push.sh::metric name="
        },
        {
          "l": "log",
          "m": "metric name=gateway_gate_failures labels=project=\"core-api\" value=0",
          "p": "observability-push.sh::metric name="
        },
        {
          "l": "log",
          "m": "metric name=gateway_pipeline_warnings labels=project=\"core-api\" value=1",
          "p": "observability-push.sh::metric name="
        },
        {
          "l": "warn",
          "m": "skipped metric=duration_seconds reason=not_reported_by_runner",
          "p": "observability-push.sh::skipped metric=duration_seconds"
        },
        {
          "l": "log",
          "m": "audit release=R1.4.3 project=core-api passed=1 warnings=1 pipeline=1421",
          "p": "observability-push.sh::audit release="
        },
        {
          "l": "log",
          "m": "written file=metrics.prom metrics=3",
          "p": "observability-push.sh::written file="
        },
        {
          "l": "log",
          "m": "pushed url=http://pushgateway.platform.svc:9091 status=200",
          "p": "observability-push.sh::pushed url="
        },
        {
          "l": "out",
          "m": "  when: always, because the failure is the number a dashboard most needs",
          "p": "backend.yml::when: always"
        },
        {
          "l": "out",
          "m": "  the platform layer pushes deploy timings as well: observability-push.sh deploy --env sit",
          "p": "platform.yml::observability-push.sh deploy"
        },
        {
          "l": "log",
          "m": "metric name=gateway_release_passed labels=project=\"core-api\",version=\"R1.4.3\" value=0",
          "p": "observability-push.sh::metric name=",
          "when": "refused"
        }
      ]
    },
    "jenkins": {
      "trigger": [
        {
          "l": "cmd",
          "m": "stage('Trigger Jobs') { script { def jsonObject = readJSON(text: DATA) } }",
          "p": "GatewaySIT.groovy::readJSON(text: DATA)"
        },
        {
          "l": "out",
          "m": "=== === === === Trigger Jobs === === === ===",
          "p": "GatewaySIT.groovy::=== === === ==="
        },
        {
          "l": "out",
          "m": "ISSUE_KEY: FIN-471",
          "p": "GatewaySIT.groovy::ISSUE_KEY:"
        },
        {
          "l": "out",
          "m": "ISSUE_SUMMARY: timeout on the settlement read path",
          "p": "GatewaySIT.groovy::ISSUE_SUMMARY:"
        },
        {
          "l": "out",
          "m": "FROM_STATUS: in development",
          "p": "GatewaySIT.groovy::FROM_STATUS:"
        },
        {
          "l": "out",
          "m": "TO_STATUS: ready for sit",
          "p": "GatewaySIT.groovy::TO_STATUS:"
        },
        {
          "l": "out",
          "m": "STAGE: SIT",
          "p": "GatewaySIT.groovy::STAGE:"
        },
        {
          "l": "out",
          "m": "  the identity of this run came from the changelog of a ticket, not from someone typing it twice",
          "p": "GatewaySIT.groovy::changelog"
        },
        {
          "l": "out",
          "m": "  customfield_10744 carries the stage the board moved the ticket to",
          "p": "GatewaySIT.groovy::customfield_10744"
        }
      ],
      "route": [
        {
          "l": "cmd",
          "m": "def jobKey = \"${FROM_STATUS}:${TO_STATUS}\".trim().toLowerCase()",
          "p": "GatewaySIT.groovy::FROM_STATUS}:${TO_STATUS"
        },
        {
          "l": "out",
          "m": "  key \"in development:ready for sit\" found in the transition table",
          "p": "GatewaySIT.groovy::jobMapping"
        },
        {
          "l": "out",
          "m": "Running job: GatewaySITDeploy with parameter: ISSUE_KEY=FIN-471",
          "p": "GatewaySIT.groovy::Running job:"
        },
        {
          "l": "out",
          "m": "  build job: GatewaySITDeploy, string(name: 'ISSUE_KEY'), wait: false",
          "p": "GatewaySIT.groovy::wait: false"
        },
        {
          "l": "out",
          "m": "  a transition with no row stops here: \"No job matches the transition ...\"",
          "p": "GatewaySIT.groovy::No job matches the transition"
        },
        {
          "l": "out",
          "m": "  the lookup is a containsKey on the transition table, not a string match on a summary",
          "p": "GatewaySIT.groovy::containsKey"
        }
      ],
      "ticket": [
        {
          "l": "cmd",
          "m": "validateTicket(manifest: release.json, branch: env.BRANCH)",
          "p": "validateTicket.groovy::validateManifest(manifest)"
        },
        {
          "l": "out",
          "m": "validateTicket: branch=fix/471-timeout promotion=none problems=0",
          "p": "validateTicket.groovy::validateTicket: branch="
        },
        {
          "l": "out",
          "m": "release standard met: 3 service(s) for v1.4.2",
          "p": "validateTicket.groovy::release standard met:"
        },
        {
          "l": "out",
          "m": "  every problem is reported at once: stopping at the first one teaches people to fix one field and re-run",
          "p": "validateTicket.groovy::Every"
        },
        {
          "l": "out",
          "m": "  the problems go back to the ticket before the build is failed",
          "p": "validateTicket.groovy::commentOnTicket"
        }
      ],
      "labels": [
        {
          "l": "cmd",
          "m": "getReleaseLabels(allLabels)",
          "p": "GatewaySIT.groovy::getReleaseLabels"
        },
        {
          "l": "out",
          "m": "  labels on FIN-471: R1.4, regression, settlement",
          "p": "GatewaySIT.groovy::releasePattern"
        },
        {
          "l": "out",
          "m": "  /^R1\\.\\d+$/ matched R1.4",
          "p": "GatewaySIT.groovy::releasePattern"
        },
        {
          "l": "out",
          "m": "  which release this ticket belongs to, read off the ticket rather than typed into a form",
          "p": "GatewaySIT.groovy::findAll"
        },
        {
          "l": "out",
          "m": "  the artifact can also come from the ticket itself: the latest attachment matching a pattern",
          "p": "GatewaySIT.groovy::getJiraAttachmentUrl"
        }
      ],
      "credentials": [
        {
          "l": "cmd",
          "m": "vaultCredentials(role: 'sit-deploy', ttl: '10m') { ... }",
          "p": "vaultCredentials.groovy::vaultCredentials: role is required"
        },
        {
          "l": "out",
          "m": "+ printf %s <jwt> | vault write -field=token -no-table jwt/issue/sit-deploy ttl=10m -",
          "p": "vaultCredentials.groovy::vault write -field=token"
        },
        {
          "l": "out",
          "m": "lease issued role=sit-deploy mount=jwt ttl=10m",
          "p": "vaultCredentials.groovy::lease issued role="
        },
        {
          "l": "out",
          "m": "lease revoking role=sit-deploy",
          "p": "vaultCredentials.groovy::lease revoking role="
        },
        {
          "l": "out",
          "m": "+ vault token revoke -self",
          "p": "vaultCredentials.groovy::vault token revoke -self"
        },
        {
          "l": "out",
          "m": "  the token is never echoed and never a command argument: arguments land in the step log and in ps",
          "p": "vaultCredentials.groovy::never echoed"
        },
        {
          "l": "out",
          "m": "  the token arrives inside withEnv as an environment variable, never as an argument",
          "p": "vaultCredentials.groovy::withEnv"
        },
        {
          "l": "out",
          "m": "  the lease is still revoked when the stage fails halfway: the finally block is the only exit",
          "p": "vaultCredentials.groovy::finally"
        }
      ],
      "quality": [
        {
          "l": "cmd",
          "m": "qualityGate(deploy: result, quality: sq, scan: scan, issue: ISSUE_KEY)",
          "p": "qualityGate.groovy::GateResult.evaluate"
        },
        {
          "l": "out",
          "m": "  coverage 81.4% (floor 40.0%) \u00b7 duplication 3.1% (ceiling 8.0%)",
          "p": "GateResult.groovy::coverageFloor"
        },
        {
          "l": "out",
          "m": "Quality gate: passed. 1 medium finding accepted for this release",
          "p": "qualityGate.groovy::Quality gate: passed"
        },
        {
          "l": "out",
          "m": "  the comment is written before the build is failed, so the engineer who reads it tomorrow gets a reason",
          "p": "qualityGate.groovy::written before the build is failed"
        },
        {
          "l": "out",
          "m": "  the same comment path the GitLab job uses, reached from the other engine",
          "p": "qualityGate.groovy::commentOnTicket"
        }
      ],
      "gate": [
        {
          "l": "cmd",
          "m": "GateResult.evaluate([deploy: deployResult, quality: sq, scan: scan])",
          "p": "GateResult.groovy::static Map evaluate(Map input)"
        },
        {
          "l": "out",
          "m": "THRESHOLDS critical=0 high=5 coverageFloor=40.0 duplicationCeiling=8.0",
          "dyn": "thresholds",
          "p": "GateResult.groovy::criticalVulnerabilities"
        },
        {
          "l": "out",
          "m": "  deploy: success \u00b7 quality: passed \u00b7 scan: 3 findings, sbom present",
          "p": "GateResult.groovy::severityCounts"
        },
        {
          "l": "ok",
          "m": "gate passed",
          "p": "GateResult.groovy::gate passed",
          "when": "passed"
        },
        {
          "l": "out",
          "m": "  absent evidence fails: a scanner that timed out and a clean image look identical unless the code says otherwise",
          "p": "GateResult.groovy::no report, treated as unscanned"
        },
        {
          "l": "out",
          "m": "  one of the failure strings is exact: sbom: not produced, a release nobody can inventory",
          "p": "GateResult.groovy::sbom: not produced"
        },
        {
          "l": "err",
          "m": "gate failed: vulnerabilities: 1 critical (allowed 0)",
          "p": "GateResult.groovy::gate failed: ",
          "when": "refused"
        }
      ],
      "plan": [
        {
          "l": "cmd",
          "m": "deployPlan(manifest: release.json, env: 'sit', issue: ISSUE_KEY)",
          "p": "deployPlan.groovy::DeploymentPlan.build"
        },
        {
          "l": "out",
          "m": "plan: 3 service(s) in 2 wave(s)",
          "p": "deployPlan.groovy::plan: "
        },
        {
          "l": "out",
          "m": "  deploy 1001 (jar) wm 4e21c7f0",
          "p": "deployPlan.groovy::triggerServicePipeline"
        },
        {
          "l": "out",
          "m": "  deploy 1006 (image) wm 9b3b1d55",
          "p": "deployPlan.groovy::triggerServicePipeline"
        },
        {
          "l": "out",
          "m": "  deploy 1020 (web) wm 2c8f6a10",
          "p": "deployPlan.groovy::triggerServicePipeline"
        },
        {
          "l": "out",
          "m": "  a wave that partially failed stops the next one: the release is the unit of correctness",
          "p": "deployPlan.groovy::wave "
        },
        {
          "l": "out",
          "m": "  rendered into jenkins/templates/deployment.yaml, applied to ci-sit-ledger-service",
          "p": "deployment.yaml::{NAMESPACE}"
        },
        {
          "l": "out",
          "m": "  a service already on the environment is announced as skipped, not dropped quietly",
          "p": "deployPlan.groovy::skip"
        }
      ],
      "promote": [
        {
          "l": "cmd",
          "m": "ReleaseRules.validatePromotion('sit', 'uat')",
          "p": "ReleaseRules.groovy::validatePromotion"
        },
        {
          "l": "out",
          "m": "  ENV_TARGET_BRANCH maps each environment to the branch a promotion merges into",
          "p": "ReleaseRules.groovy::ENV_TARGET_BRANCH"
        },
        {
          "l": "out",
          "m": "  the button is here; the right to press it is the approval chain",
          "p": "mergeApprove.groovy::approvalChainProblems"
        }
      ],
      "notify": [
        {
          "l": "cmd",
          "m": "mergeApprove(approvals: chain, merger: currentActor, issue: ISSUE_KEY)",
          "p": "mergeApprove.groovy::approvalChainProblems"
        },
        {
          "l": "out",
          "m": "approval chain: layers=5 problems=0 merger=eng-manager-3",
          "p": "mergeApprove.groovy::approval chain: layers="
        },
        {
          "l": "out",
          "m": "merge approved by chain: eng-manager-3 merging as be-core-lead",
          "p": "mergeApprove.groovy::merge approved by chain:",
          "when": "passed"
        },
        {
          "l": "out",
          "m": "  whoever signed the last layer may not merge it: checked where the merge happens, not where the approval was recorded",
          "p": "mergeApprove.groovy::Segregation of duties"
        },
        {
          "l": "out",
          "m": "  the refusal is a count of problems; the detail is on the ticket",
          "p": "mergeApprove.groovy::merge refused"
        },
        {
          "l": "err",
          "m": "merge refused: 1 problem(s)",
          "p": "mergeApprove.groovy::merge refused",
          "when": "refused"
        }
      ]
    }
  },
  "gate": [
    {
      "l": "cmd",
      "m": "$ release-rules evaluate --manifest release.json --scan trivy-report.json --quality sonar-gate.json",
      "p": "run-gate.groovy::--manifest"
    },
    {
      "l": "out",
      "m": "THRESHOLDS  critical=0  high=5  coverageFloor=40.0  duplicationCeiling=8.0",
      "p": "GateResult.groovy::criticalVulnerabilities",
      "dyn": "thresholds"
    },
    {
      "l": "out",
      "m": "scan.findings   critical 0  high 2  medium 1  low 0",
      "p": "GateResult.groovy::severityCounts",
      "dyn": "counts"
    },
    {
      "l": "out",
      "m": "approvals       team business product architecture engineering  (distinct identities required)",
      "p": "ReleaseRules.groovy::approvalChainProblems"
    },
    {
      "l": "out",
      "m": "plan            core-api tier 1  messaging tier 1  portal tier 3",
      "p": "DeploymentPlan.groovy::TIER",
      "dyn": "plan"
    },
    {
      "l": "out",
      "m": "waves           1: core-api,messaging  2: portal",
      "p": "DeploymentPlan.groovy::waves"
    },
    {
      "l": "ok",
      "m": "gate passed",
      "p": "GateResult.groovy::gate passed",
      "dyn": "summary"
    },
    {
      "l": "warn",
      "m": "  warning: 1 medium finding accepted for this release",
      "p": "GateResult.groovy::medium findings accepted",
      "dyn": "warnings"
    },
    {
      "l": "out",
      "m": "refused, when it happens, reads: deploy: no result reported \u00b7 quality gate: no status received, treated as failed \u00b7 vulnerability scan: no report, treated as unscanned \u00b7 sbom: not produced, a release nobody can inventory",
      "p": "GateResult.groovy::treated as unscanned"
    },
    {
      "l": "err",
      "m": "",
      "p": "GateResult.groovy::treated as unscanned",
      "dyn": "failures"
    },
    {
      "l": "out",
      "m": "the same lines are what GateResult.evaluate returns in Groovy, and rules/fixture.json is what holds the port to them",
      "p": "GateResult.groovy::static Map verdict"
    }
  ]
}
