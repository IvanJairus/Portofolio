        },
        {
          "l": "log",
          "m": "commit branch=fix/471-timeout short=a1b2c3d tag=none lastTag=R1.4.2",
          "p": "release_stamp.py::commit branch="
        },
        {
          "l": "log",
          "m": "artifacts requested=1 present=1 missing=0 paths=target/core-api-R1.4.3.jar",
          "p": "release_stamp.py::artifacts requested="
        },
        {
          "l": "log",
          "m": "stamped version=R1.4.3 commit=a1b2c3d artifacts=1 status=success",
          "p": "release_stamp.py::stamped version={info['version']}"
        },
        {
          "l": "log",
          "m": "written file=build-info.json bytes=306 prefix=R pipeline=1421",
          "p": "release_stamp.py::written file="
        },
        {
          "l": "log",
          "m": "audit release=R1.4.3 pipeline=1421 branch=fix/471-timeout",
          "p": "release_stamp.py::audit release="
        },
        {
          "l": "out",
          "m": "  one bump rule for five templates: next_version() is the only place a patch number moves",
          "p": "release_stamp.py::def next_version"
        },
        {
          "l": "out",
          "m": "  with no tag to read, the version starts at the prefix and 0.1.0",
          "p": "release_stamp.py::0.1.0"
        }
      ],
