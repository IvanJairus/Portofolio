{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://vitals.vercel-insights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), hid=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=(), clipboard-write=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(portfolio/)?assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(portfolio/)?assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(portfolio/)?assets/cv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(portfolio/)?assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(portfolio/)?assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/decisions",
      "destination": "/decisions/index.html"
    },
    {
      "source": "/portfolio/decisions/",
      "destination": "/decisions/index.html"
    },
    {
      "source": "/portfolio/reports",
      "destination": "/reports/index.html"
    },
    {
      "source": "/portfolio/reports/",
      "destination": "/reports/index.html"
    },
    {
      "source": "/portfolio/pipelines",
      "destination": "/pipelines/index.html"
    },
    {
      "source": "/portfolio/pipelines/",
      "destination": "/pipelines/index.html"
    },
    {
      "source": "/portfolio/diagrams",
      "destination": "/diagrams/index.html"
    },
    {
      "source": "/portfolio/diagrams/",
      "destination": "/diagrams/index.html"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portofolio-six-delta-18\\.vercel\\.app"
        }
      ],
      "destination": "https://www.ivanjairus.xyz/portfolio/$1",
      "statusCode": 308
    }
  ]
}
